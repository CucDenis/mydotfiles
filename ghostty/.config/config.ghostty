# Appearance
font-family = "JetBrains Mono"
font-size = 15
theme = Catppuccin Mocha
window-theme = dark
background-opacity = 0.75
background-blur = 35
cursor-style = bar
cursor-style-blink = false
background-opacity-cells = true
macos-titlebar-style = transparent
macos-window-buttons = visible
macos-window-shadow = true
window-theme = dark
macos-icon = glass
# Make Option behave as Alt for terminal programs
macos-option-as-alt = true

# Keep Ghostty’s zsh integration enabled
shell-integration = detect

# Local terminal workspace shortcuts
keybind = cmd+alt+v=new_split:right
keybind = cmd+alt+s=new_split:down

keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

keybind = cmd+alt+z=toggle_split_zoom
keybind = cmd+alt+e=equalize_splits
keybind = cmd+alt+w=close_surface
